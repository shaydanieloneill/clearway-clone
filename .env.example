# Copy this file to .env and fill in real values (never commit .env)

# --- Twilio (Console → Account Info) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here
# Your Twilio UK number, E.164 format
TWILIO_FROM_NUMBER=+441234567890

# --- Resend (resend.com → API Keys) ---
RESEND_API_KEY=re_xxxxxxxxxxxx
# Must be on a domain you verified in Resend; the resend.dev fallback works for testing
RESEND_FROM_EMAIL=Clearway AI <alerts@aiclearway.com>

# --- Retell (dashboard → API Keys). Used to verify webhooks really come from Retell.
# Leave blank to disable signature checking (only do this while testing locally).
RETELL_API_KEY=

# --- Testing ---
# Any random string. Requests with header "x-test-secret: <this value>" skip
# signature verification so you can POST sample payloads manually.
TEST_SECRET=change-me-to-something-random

# Set to true to log SMS/email instead of actually sending (safe local testing)
DRY_RUN=false

PORT=3000
